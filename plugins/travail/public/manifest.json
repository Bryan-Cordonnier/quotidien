{
  "id": "travail",
  "name": "Travail",
  "version": "0.4.3",
  "apiVersion": "^3",
  "author": "Bryan Cordonnier",
  "description": "Vos contrats et vos paies : missions d'intérim avec leurs agences, jours de réserve, CDD et CDI. Dit combien vous serez payé et quand ; l'argent réel et le budget restent dans d'autres plugins. Les taux se règlent dans Paramètres.",
  "color": "#d99a2b",
  "icon": "weight",
  "permissions": [
    "appelle:budget:ecriture",
    "appelle:agenda:ecriture",
    "appelle:finances:lecture",
    "appelle:finances:ecriture",
    "reglages",
    "fichiers"
  ],
  "services": {
    "budget": "^1",
    "agenda": "^1",
    "finances": "^1"
  },
  "optionalDependencies": {
    "budget": "^1",
    "agenda": "^1",
    "finances": "^1"
  },
  "apps": [
    {
      "id": "travail",
      "name": "Travail",
      "entry": "apps/travail/index.html",
      "accepts": []
    },
    {
      "id": "widgets",
      "name": "Widgets",
      "entry": "apps/widgets/index.html",
      "accepts": []
    }
  ],
  "pages": [
    {
      "id": "travail",
      "title": "Travail",
      "icon": "travail",
      "category": "Temps",
      "layout": {
        "type": "app",
        "app": "travail"
      }
    }
  ],
  "parameters": [
    {
      "id": "cotisations",
      "label": "Cotisations salariales par défaut",
      "type": "number",
      "default": 22,
      "group": "Paie",
      "step": 0.5,
      "min": 0,
      "hint": "Hypothèse à confirmer sur un vrai bulletin ; chaque agence peut avoir son taux.",
      "unit": "%",
      "max": 60
    },
    {
      "id": "delaiPaie",
      "label": "Délai avant la paie (sans jour de paie)",
      "type": "number",
      "default": 7,
      "group": "Paie",
      "step": 1,
      "min": 0,
      "hint": "Pour une agence sans « jour de paie » (réglé dans Travail, sur l'agence) et pour la réserve : jours après le dernier jour travaillé, jamais un week-end ni un jour férié.",
      "unit": "jours",
      "max": 90
    },
    {
      "id": "ifm",
      "label": "Indemnité de fin de mission",
      "type": "number",
      "default": 10,
      "group": "Intérim",
      "step": 0.5,
      "min": 0,
      "hint": "légal : 10 % du brut",
      "unit": "%",
      "max": 30
    },
    {
      "id": "cp",
      "label": "Congés payés",
      "type": "number",
      "default": 10,
      "group": "Intérim",
      "step": 0.5,
      "min": 0,
      "hint": "légal : 10 % du brut et de l'indemnité de fin de mission",
      "unit": "%",
      "max": 30
    },
    {
      "id": "seuilSemaine",
      "label": "Heures normales par semaine",
      "type": "number",
      "default": 35,
      "group": "Heures supplémentaires",
      "step": 0.5,
      "min": 0,
      "unit": "h",
      "max": 60
    },
    {
      "id": "majoration1",
      "label": "Majoration des premières heures supplémentaires",
      "type": "number",
      "default": 25,
      "group": "Heures supplémentaires",
      "step": 1,
      "min": 0,
      "hint": "légal : +25 %",
      "unit": "%",
      "max": 200
    },
    {
      "id": "seuilMajoration1",
      "label": "Nombre d'heures payées à la première majoration",
      "type": "number",
      "default": 8,
      "group": "Heures supplémentaires",
      "step": 0.5,
      "min": 0,
      "hint": "par semaine, légal : 8 h",
      "unit": "h",
      "max": 40
    },
    {
      "id": "majoration2",
      "label": "Majoration des heures suivantes",
      "type": "number",
      "default": 50,
      "group": "Heures supplémentaires",
      "step": 1,
      "min": 0,
      "hint": "légal : +50 %",
      "unit": "%",
      "max": 200
    },
    {
      "id": "tarifReserve",
      "label": "Solde d'un jour de réserve (imposable)",
      "type": "number",
      "default": 60,
      "group": "Réserve",
      "step": 1,
      "min": 0,
      "hint": "Chaque jour, à la base ou hors base. Brut ; les cotisations sont déduites.",
      "unit": "€",
      "max": 10000
    },
    {
      "id": "indemniteReserve",
      "label": "Prime d'un jour hors base (non imposable)",
      "type": "number",
      "default": 38,
      "group": "Réserve",
      "step": 1,
      "min": 0,
      "hint": "En plus du solde, seulement les jours hors base. Pas de cotisations.",
      "unit": "€",
      "max": 10000
    },
    {
      "id": "baseNom",
      "label": "Nom de ma base",
      "type": "text",
      "default": "",
      "group": "Réserve",
      "hint": "Affiché dans l'agenda."
    },
    {
      "id": "baseAdresse",
      "label": "Adresse de ma base",
      "type": "text",
      "default": "",
      "group": "Réserve",
      "hint": "Lieu des jours à la base dans l'agenda, pour calculer le trajet."
    },
    {
      "id": "reserveDebut",
      "label": "Heure d'arrivée habituelle à la base (nouvelle mission)",
      "hint": "Proposée à chaque nouvelle mission de réserviste ; elle ne change jamais la paie.",
      "type": "time",
      "default": "08:00",
      "group": "Réserve"
    },
    {
      "id": "reserveFin",
      "label": "Heure de départ habituelle (nouvelle mission)",
      "hint": "Proposée à chaque nouvelle mission ; elle ne change jamais la paie.",
      "type": "time",
      "default": "17:00",
      "group": "Réserve"
    },
    {
      "id": "precarite",
      "label": "Prime de précarité (CDD)",
      "type": "number",
      "default": 10,
      "group": "CDD",
      "step": 0.5,
      "min": 0,
      "hint": "légal : 10 % du brut total",
      "unit": "%",
      "max": 30
    },
    {
      "id": "cpCdd",
      "label": "Congés payés non pris (CDD)",
      "type": "number",
      "default": 10,
      "group": "CDD",
      "step": 0.5,
      "min": 0,
      "hint": "légal : 10 % du brut total",
      "unit": "%",
      "max": 30
    }
  ],
  "widgets": [
    {
      "id": "mission",
      "title": "Mission",
      "icon": "travail",
      "app": "widgets",
      "sizes": [
        "2x1",
        "2x2"
      ],
      "default": "2x1"
    }
  ]
}
