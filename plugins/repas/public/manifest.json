{
  "id": "repas",
  "name": "Repas et recettes",
  "version": "0.1.0",
  "apiVersion": "^3",
  "author": "Bryan Cordonnier",
  "description": "Concocter les repas de la semaine dans votre budget avec l'IA, et une bibliothèque de recettes rangée par rayons d'où l'on tire sa liste de courses au magasin le moins cher.",
  "color": "#d9893f",
  "icon": "flame",
  "permissions": [
    "appelle:courses:lecture",
    "appelle:courses:ecriture",
    "reglages",
    "ia"
  ],
  "services": {
    "courses": "^1",
    "sante": "^1"
  },
  "optionalDependencies": {
    "courses": "^1",
    "sante": "^1"
  },
  "apps": [
    {
      "id": "concocter",
      "name": "Concocter",
      "entry": "apps/concocter/index.html",
      "accepts": []
    },
    {
      "id": "recettes",
      "name": "Recettes",
      "entry": "apps/recettes/index.html",
      "accepts": []
    }
  ],
  "pages": [
    {
      "id": "concocter",
      "title": "Concocter",
      "icon": "repas",
      "category": "Maison",
      "layout": {
        "type": "app",
        "app": "concocter"
      }
    },
    {
      "id": "recettes",
      "title": "Recettes",
      "icon": "recettes",
      "category": "Maison",
      "layout": {
        "type": "app",
        "app": "recettes"
      }
    }
  ],
  "parameters": [
    {
      "id": "personnes",
      "label": "Personnes au foyer",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 20,
      "step": 1,
      "group": "Repas",
      "hint": "Le nombre de parts proposé pour chaque repas ; les invités se règlent dans Concocter."
    }
  ]
}
