{
  "id": "repas",
  "name": "Repas",
  "version": "0.4.0",
  "apiVersion": "^3",
  "author": "Bryan Cordonnier",
  "description": "Vos recettes (favoris, recherche, valeurs nutritionnelles), à ajouter aux courses d'un geste ; Concocter crée les repas de la semaine dans votre budget avec l'IA.",
  "color": "#d9893f",
  "icon": "flame",
  "permissions": [
    "appelle:courses:lecture",
    "appelle:courses:ecriture",
    "reglages",
    "ia",
    "appelle:agenda:ecriture"
  ],
  "services": {
    "courses": "^1",
    "sante": "^1",
    "agenda": "^1"
  },
  "optionalDependencies": {
    "courses": "^1",
    "sante": "^1",
    "agenda": "^0.2"
  },
  "apps": [
    {
      "id": "semaine",
      "name": "Repas",
      "entry": "apps/semaine/index.html",
      "accepts": []
    },
    {
      "id": "recettes",
      "name": "Repas",
      "entry": "apps/recettes/index.html",
      "accepts": []
    }
  ],
  "pages": [
    {
      "id": "semaine",
      "title": "Repas",
      "icon": "repas",
      "category": "Maison",
      "layout": {
        "type": "app",
        "app": "semaine"
      }
    },
    {
      "id": "recettes",
      "title": "Recettes",
      "icon": "recettes",
      "category": "Maison",
      "layout": {
        "type": "app",
        "app": "recettes"
      }
    }
  ],
  "parameters": [
    {
      "id": "personnes",
      "label": "Personnes au foyer",
      "type": "number",
      "default": 1,
      "min": 1,
      "max": 20,
      "step": 1,
      "group": "Repas",
      "hint": "Le nombre de parts proposé pour chaque repas ; les invités se règlent repas par repas dans Concocter."
    },
    {
      "id": "ustensiles",
      "label": "Mes ustensiles",
      "type": "text",
      "default": "",
      "group": "Repas",
      "hint": "Séparés par des virgules (ex. : poêle, four, mixeur, cocotte-minute). L'IA ne propose que des recettes faisables avec."
    }
  ],
  "provides": {
    "repas": "1"
  }
}