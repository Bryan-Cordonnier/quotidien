{
  "id": "agenda",
  "name": "Agenda",
  "version": "0.2.7",
  "apiVersion": "^3",
  "author": "Bryan Cordonnier",
  "description": "Votre temps : calendrier, événements qui se répètent, heures de départ, réveil et coucher calculées à rebours, alertes de repos légal, rappels sur le téléphone, export .ics.",
  "color": "#6d55d6",
  "icon": "clock",
  "permissions": [
    "trajets",
    "fichiers",
    "notifications",
    "reglages"
  ],
  "provides": {
    "agenda": "1",
    "rappels": "1"
  },
  "serviceEntry": "service/index.html",
  "functions": {
    "agenda": {
      "evenements.liste": {
        "acces": "lecture"
      },
      "plages.occupees": {
        "acces": "lecture"
      },
      "evenements.remplacer": {
        "acces": "ecriture"
      },
      "evenements.supprimer": {
        "acces": "ecriture"
      }
    },
    "rappels": {
      "rappels.remplacer": {
        "acces": "ecriture"
      },
      "rappels.annuler": {
        "acces": "ecriture"
      },
      "rappels.etat": {
        "acces": "lecture"
      }
    }
  },
  "apps": [
    {
      "id": "calendrier",
      "name": "Agenda",
      "entry": "apps/calendrier/index.html",
      "accepts": []
    },
    {
      "id": "rappels",
      "name": "Rappels",
      "entry": "apps/rappels/index.html",
      "accepts": []
    },
    {
      "id": "widgets",
      "name": "Widgets",
      "entry": "apps/widgets/index.html",
      "accepts": []
    }
  ],
  "pages": [
    {
      "id": "calendrier",
      "title": "Agenda",
      "icon": "calendrier",
      "category": "Temps",
      "layout": {
        "type": "app",
        "app": "calendrier"
      }
    }
  ],
  "parameters": [
    {
      "id": "leverDefaut",
      "label": "Heure de lever par défaut",
      "type": "time",
      "default": "08:00",
      "group": "Le matin",
      "hint": "Les jours sans travail ni rendez-vous tôt le matin."
    },
    {
      "id": "preparation",
      "label": "Préparation",
      "type": "number",
      "default": 45,
      "group": "Le matin",
      "step": 5,
      "min": 0,
      "hint": "Du réveil au départ : douche, habits, petit-déjeuner.",
      "unit": "min",
      "max": 480
    },
    {
      "id": "miseEnRoute",
      "label": "Mise en route",
      "type": "number",
      "default": 10,
      "group": "Le matin",
      "step": 5,
      "min": 0,
      "hint": "Chaussures, clés, porte : juste avant de partir.",
      "unit": "min",
      "max": 240
    },
    {
      "id": "marge",
      "label": "Marge d'arrivée",
      "type": "number",
      "default": 10,
      "group": "Trajets",
      "step": 1,
      "min": 0,
      "hint": "Arriver en avance. D'où tu pars (tes domiciles, le GPS) se règle dans Paramètres → Trajets et domiciles.",
      "unit": "min",
      "max": 240
    },
    {
      "id": "majoration",
      "label": "Majoration du trajet",
      "type": "number",
      "default": 0,
      "group": "Trajets",
      "step": 1,
      "min": 0,
      "hint": "Ajouté au temps de trajet calculé, pour les imprévus.",
      "unit": "%",
      "max": 200
    },
    {
      "id": "enchainer",
      "label": "Enchaîner deux événements séparés de moins de",
      "type": "number",
      "default": 90,
      "group": "Trajets",
      "step": 5,
      "min": 0,
      "hint": "Un seul trajet direct, pas de retour à la maison entre les deux.",
      "unit": "min",
      "max": 600
    },
    {
      "id": "sommeil",
      "label": "Cible de sommeil",
      "type": "number",
      "default": 8,
      "group": "Sommeil",
      "step": 0.5,
      "min": 0,
      "unit": "h",
      "max": 16,
      "hint": "Le coucher conseillé se calcule à rebours depuis le réveil du lendemain."
    },
    {
      "id": "endormissement",
      "label": "Temps pour s'endormir",
      "type": "number",
      "default": 15,
      "group": "Sommeil",
      "step": 5,
      "min": 0,
      "unit": "min",
      "max": 240,
      "hint": "Entre le coucher et le sommeil."
    },
    {
      "id": "preAlerte",
      "label": "« Pars dans X min » avant le départ",
      "type": "number",
      "default": 5,
      "group": "Rappels",
      "step": 1,
      "min": 0,
      "unit": "min",
      "max": 120,
      "hint": "Sur le téléphone, en plus de « Pars maintenant »."
    },
    {
      "id": "rappelCoucher",
      "label": "Rappel du coucher, avant l'heure",
      "type": "number",
      "default": 30,
      "group": "Rappels",
      "step": 5,
      "min": 0,
      "unit": "min",
      "max": 240
    },
    {
      "id": "rappelsHoraires",
      "label": "Programmer les rappels de l'agenda",
      "type": "boolean",
      "default": true,
      "group": "Rappels",
      "hint": "« Pars dans X min », « Pars maintenant », « Coucher » (téléphone)."
    }
  ],
  "widgets": [
    {
      "id": "aujourdhui",
      "title": "Aujourd'hui",
      "icon": "calendrier",
      "app": "widgets",
      "sizes": [
        "2x2",
        "2x1",
        "1x2"
      ],
      "default": "2x2"
    },
    {
      "id": "coucher",
      "title": "Coucher conseillé",
      "icon": "calendrier",
      "app": "widgets",
      "sizes": [
        "1x1",
        "2x1"
      ],
      "default": "1x1"
    }
  ]
}
